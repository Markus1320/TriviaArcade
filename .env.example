# Copy to .env and fill in real values. Never commit .env.
# The game itself needs nothing from here: every value has a default.

# --- Game ---
# Port the game publishes on all interfaces (default 8080).
GAME_PORT=8080
# Seconds to answer each question, counted from when it is shown (default 30, 0 = no timer).
ANSWER_TIME_SECONDS=30
# 1UPs (hearts): correct answers in a row for one (default 3), the most a player can hold
# (default 3) and how many a new run starts with (default 1, at most MAX_LIVES).
LIFE_COMBO=3
MAX_LIVES=3
START_LIVES=1

# --- Offline: knowledge graph (docker compose --profile offline) ---
# The Community Edition admin user is always "neo4j". Password needs at least 8 characters.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
# Optional memory limits for Neo4j.
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512M

# --- Offline: making questions (poolgen) ---
# API key for the Ollama account (empty for a local Ollama).
OLLAMA_API_KEY=your-ollama-api-key
# Base URL of the Ollama API: https://ollama.com for the cloud.
OLLAMA_BASE_URL=https://ollama.com
# Model that writes questions. Check that your account can use the tag.
LLM_GENERATOR_MODEL=generator-model-tag
# Model that reviews and blind-solves questions, best from another model family, e.g.
# gpt-oss:120b.
LLM_CRITIC_MODEL=critic-model-tag
# Optional: seconds to wait for one LLM response (default 120).
LLM_TIMEOUT_SECONDS=120
# Random walk: number of relations it follows, and how strongly each hop avoids hubs such
# as the United States (0 = not at all, default 0.5).
WALK_MIN_HOPS=1
WALK_MAX_HOPS=2
WALK_HUB_PENALTY=0.5
