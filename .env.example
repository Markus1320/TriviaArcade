# Copy to .env and fill in real values. Never commit .env.

# --- LLM (Ollama cloud API, needed from milestone 3) ---
# API key for the Ollama account.
OLLAMA_API_KEY=your-ollama-api-key
# Base URL of the Ollama API.
OLLAMA_BASE_URL=https://ollama.com
# Model that writes questions (a recent Gemma or Qwen model). Check available tags first.
LLM_GENERATOR_MODEL=generator-model-tag
# Smaller, cheaper model that judges answers. Check available tags first.
LLM_JUDGE_MODEL=judge-model-tag

# --- PostgreSQL (players, runs, leaderboard, logs) ---
POSTGRES_USER=trivia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trivia

# --- Neo4j (knowledge graph) ---
# The Community Edition admin user is always "neo4j". Password needs at least 8 characters.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
# Optional memory limits for Neo4j.
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512M

# --- Network ---
# Port Caddy publishes on all interfaces.
CADDY_PORT=8080
